[1.518618, "o", "\u001b[?1h\u001b=\r\u001b[33mfdee95a\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32mdouble-precision-path\u001b[m\u001b[33m)\u001b[m tests: add dual-precision verification e\u001b[m \b\u001b[33m\u001b[m\u001b[33m\u001b[m\u001b[1;36m\u001b[m\u001b[33m\u001b[m\u001b[1;32m\u001b[m\u001b[33m\u001b[mntry point\u001b[m\r\n"]
[1.518659, "o", "\u001b[33m25b5ef2\u001b[m precision layer: add widen helper, keep float build arithmetic identical\u001b[m\r\n\u001b[33ma3e2af8\u001b[m linear,zoh: keep last-value state in internal precision\u001b[m\r\n\u001b[33m5379836\u001b[m sinc: route coefficients and delay line through precision layer\u001b[m\r\n\u001b[33mf4197f8\u001b[m Add shared precision selection layer (src_precision.h)\u001b[m\r\n\r\u001b[K\u001b[?1l\u001b>"]
